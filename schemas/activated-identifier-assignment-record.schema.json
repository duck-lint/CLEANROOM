{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActivatedIdentifierAssignmentRecord",
  "description": "Positive identifier-assignment visible in the working view.",
  "type": "object",
  "required": [
    "activation_provenance",
    "assignment_id",
    "available_surface_ids",
    "identifier_name",
    "record_provenance",
    "subject",
    "value"
  ],
  "properties": {
    "activation_provenance": {
      "description": "Reasons this assignment became visible in the working view.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ActivationProvenance"
      }
    },
    "assignment_id": {
      "description": "Snapshot-local identifier-assignment identity.",
      "type": "string"
    },
    "available_surface_ids": {
      "description": "Retrieval surfaces structurally capable of inspecting this assignment.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identifier_name": {
      "description": "Projected identifier descriptor name.",
      "type": "string"
    },
    "record_provenance": {
      "description": "Corpus or materialization provenance from the frozen projection.",
      "allOf": [
        {
          "$ref": "#/definitions/RecordProvenance"
        }
      ]
    },
    "subject": {
      "description": "Canonical projected subject of the assignment.",
      "allOf": [
        {
          "$ref": "#/definitions/SemanticAddress"
        }
      ]
    },
    "value": {
      "description": "Represented projected value.",
      "allOf": [
        {
          "$ref": "#/definitions/IdentifierValue"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ActivationBand": {
      "description": "Current activation band assigned to a problem region.\n\nA band changes visibility and foregrounding only. It does not duplicate the region or change its identity, applicability, lifecycle, or semantic strength. It is categorical and never a numeric attention or relevance score.",
      "oneOf": [
        {
          "description": "Immediate operational focus.",
          "type": "string",
          "enum": [
            "primary"
          ]
        },
        {
          "description": "Live adjacent structure that materially informs primary focus.",
          "type": "string",
          "enum": [
            "secondary"
          ]
        },
        {
          "description": "Lower-priority connected structure available for continuation.",
          "type": "string",
          "enum": [
            "tertiary"
          ]
        },
        {
          "description": "Retained continuity outside the current foreground.",
          "type": "string",
          "enum": [
            "background"
          ]
        }
      ]
    },
    "ActivationProvenance": {
      "description": "Source of positive activation for one visible record or edge.\n\nProvenance explains navigation only. It is not a relevance, confidence, or truth score and cannot close an open tension.",
      "oneOf": [
        {
          "description": "Exposed by one active problem region.",
          "type": "object",
          "required": [
            "kind",
            "region_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "problem_region"
              ]
            },
            "region_id": {
              "description": "Thread-local problem-region identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one specific problem-space referent expression.\n\nThis records the textual source that caused exposure. It does not assert that the referent is canonically bound to the activated address.",
          "type": "object",
          "required": [
            "kind",
            "referent_id",
            "region_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "problem_referent"
              ]
            },
            "referent_id": {
              "description": "Thread-local problem-referent identity.",
              "type": "string"
            },
            "region_id": {
              "description": "Containing problem-region identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one problem-space relation.",
          "type": "object",
          "required": [
            "kind",
            "relation_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "problem_relation"
              ]
            },
            "relation_id": {
              "description": "Thread-local problem-relation identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one active problem-space constraint.",
          "type": "object",
          "required": [
            "constraint_id",
            "kind"
          ],
          "properties": {
            "constraint_id": {
              "description": "Thread-local constraint identity.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "constraint"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one explicit open tension.",
          "type": "object",
          "required": [
            "kind",
            "tension_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "open_tension"
              ]
            },
            "tension_id": {
              "description": "Thread-local tension identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one preserved candidate of an open tension.\n\nCandidate order is the declared vector order in the problem-space state. Exposure does not select this candidate or resolve the tension.",
          "type": "object",
          "required": [
            "candidate_index",
            "kind",
            "tension_id"
          ],
          "properties": {
            "candidate_index": {
              "description": "Zero-based candidate index within the preserved candidate vector.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "kind": {
              "type": "string",
              "enum": [
                "open_tension_candidate"
              ]
            },
            "tension_id": {
              "description": "Thread-local open-tension identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one region's current attention band.",
          "type": "object",
          "required": [
            "band",
            "kind",
            "region_id"
          ],
          "properties": {
            "band": {
              "description": "Current band in the shared attention lens.",
              "allOf": [
                {
                  "$ref": "#/definitions/ActivationBand"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "attention_band"
              ]
            },
            "region_id": {
              "description": "Region carrying the activation band.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by the newest utterance.",
          "type": "object",
          "required": [
            "kind",
            "utterance_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "newest_utterance"
              ]
            },
            "utterance_id": {
              "description": "Current utterance identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by a deterministic configuration default.",
          "type": "object",
          "required": [
            "configuration_key",
            "kind"
          ],
          "properties": {
            "configuration_key": {
              "description": "Stable configuration key.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "configured_default"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by a typed bounded expansion request.",
          "type": "object",
          "required": [
            "kind",
            "request_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "expansion_request"
              ]
            },
            "request_id": {
              "description": "Expansion request identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "IdentifierAddress": {
      "description": "Address of an identifier descriptor or assignment.\n\nIt represents a named projected surface and optional represented value. It cannot replace canonical object or unit identity.",
      "type": "object",
      "required": [
        "identifier_name"
      ],
      "properties": {
        "identifier_name": {
          "description": "Identifier name represented by the projection.",
          "type": "string"
        },
        "represented_value": {
          "description": "Optional exact represented value used to address one assignment.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "IdentifierValue": {
      "description": "Value carried by one identifier assignment.\n\nThis is a closed structural union for exchange. It cannot be interpreted as evidence or a relation without its descriptor and provenance.",
      "oneOf": [
        {
          "description": "Authored field is present with a null value.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One string value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "string"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One signed integer value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "integer"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One boolean value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "boolean"
              ]
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One canonical address value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semantic_address"
              ]
            },
            "value": {
              "$ref": "#/definitions/SemanticAddress"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection of strings.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "strings"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection of canonical addresses.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semantic_addresses"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SemanticAddress"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RecordProvenance": {
      "description": "Provenance of a projected or retrieved fact.\n\nIt records where a fact was materialized from. It may not upgrade source authority or turn contextual participation into intrinsic typing.",
      "oneOf": [
        {
          "description": "Frontmatter field on a canonical source object.",
          "type": "object",
          "required": [
            "field_path",
            "kind",
            "object_id"
          ],
          "properties": {
            "field_path": {
              "description": "Authored field path.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "object_field"
              ]
            },
            "object_id": {
              "description": "Canonical object that owns the field.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Authored body span inside a canonical semantic unit.",
          "type": "object",
          "required": [
            "kind",
            "unit_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semantic_unit"
              ]
            },
            "source_span": {
              "description": "Optional exact source span.",
              "anyOf": [
                {
                  "$ref": "#/definitions/SourceSpan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit_id": {
              "description": "Canonical semantic unit containing the source.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Deterministically materialized structural record.",
          "type": "object",
          "required": [
            "kind",
            "rule",
            "sources"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "materialization"
              ]
            },
            "rule": {
              "description": "Named materialization rule or contract source.",
              "type": "string"
            },
            "sources": {
              "description": "Source record addresses used by the rule.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/SemanticAddress"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RetrievalSurfaceAddress": {
      "description": "Address of a retrieval-surface descriptor.\n\nIt names a projected capability only. It does not execute the surface or imply that the surface is available for a particular address.",
      "type": "object",
      "required": [
        "surface_id"
      ],
      "properties": {
        "surface_id": {
          "description": "Snapshot-local retrieval-surface identifier.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SemanticAddress": {
      "description": "Canonical or projected address used by plans and provenance records.\n\nIt can point only to represented address categories. It does not prove that the target exists in a given snapshot; structural conformance owns that later check.",
      "oneOf": [
        {
          "description": "Canonical semantic object.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Canonical semantic unit.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unit"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Authored semantic region.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "region"
              ]
            },
            "value": {
              "$ref": "#/definitions/SemanticRegionAddress"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Identifier assignment or descriptor.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "identifier"
              ]
            },
            "value": {
              "$ref": "#/definitions/IdentifierAddress"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Authored occurrence.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "occurrence"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Temporal anchor.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "temporal_anchor"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Retrieval surface.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "retrieval_surface"
              ]
            },
            "value": {
              "$ref": "#/definitions/RetrievalSurfaceAddress"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SemanticRegionAddress": {
      "description": "Address of an authored structural region inside one semantic object.\n\nThe address preserves both the canonical parent object and a non-empty authored structural address. It has no authority to select a unit, infer a heading target, or treat the region as a separate epistemic object class.",
      "type": "object",
      "required": [
        "authored_structural_address",
        "object_id"
      ],
      "properties": {
        "authored_structural_address": {
          "description": "Non-empty authored heading, block, or structural address.",
          "type": "string"
        },
        "object_id": {
          "description": "Canonical parent semantic object.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SourceSpan": {
      "description": "Authored or materialized source span.\n\nThis is provenance for a represented record. It cannot reinterpret the source or establish semantic relevance.",
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "end_byte": {
          "description": "Exclusive ending byte offset when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "source": {
          "description": "Source path or stable source identity.",
          "type": "string"
        },
        "start_byte": {
          "description": "Inclusive starting byte offset when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
