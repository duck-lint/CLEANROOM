{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContinuationHandle",
  "description": "Bounded continuation descriptor for a high-degree or truncated view.",
  "type": "object",
  "required": [
    "access",
    "activation_provenance",
    "configuration_snapshot_id",
    "filters",
    "handle_id",
    "newest_utterance_id",
    "next_offset",
    "next_page_limit",
    "ordering",
    "origin",
    "problem_space_thread_id",
    "problem_space_version",
    "projection_snapshot_id"
  ],
  "properties": {
    "access": {
      "description": "Mechanism required to interpret and continue this handle.",
      "allOf": [
        {
          "$ref": "#/definitions/ContinuationAccess"
        }
      ]
    },
    "activation_provenance": {
      "description": "Reasons the truncated neighbourhood or result set became visible.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ActivationProvenance"
      }
    },
    "configuration_snapshot_id": {
      "description": "Activation configuration snapshot required by this continuation.",
      "type": "string"
    },
    "filters": {
      "description": "Typed filters already applied to the continuation.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ContinuationFilter"
      }
    },
    "handle_id": {
      "description": "Stable handle identity.",
      "type": "string"
    },
    "newest_utterance_id": {
      "description": "Newest utterance identity used for the original activation.",
      "type": "string"
    },
    "next_offset": {
      "description": "Zero-based next offset in that stable ordering.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "next_page_limit": {
      "description": "Maximum records permitted in the next page.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "ordering": {
      "description": "Stable ordering under which the cursor is interpreted.",
      "allOf": [
        {
          "$ref": "#/definitions/ContinuationOrdering"
        }
      ]
    },
    "origin": {
      "description": "Original probe or structural neighbourhood.",
      "allOf": [
        {
          "$ref": "#/definitions/ContinuationOrigin"
        }
      ]
    },
    "problem_space_thread_id": {
      "description": "Thread whose accepted problem space shaped the original activation.",
      "type": "string"
    },
    "problem_space_version": {
      "description": "Exact accepted problem-space version used for the original activation.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "projection_snapshot_id": {
      "description": "Frozen projection snapshot required by this continuation.",
      "type": "string"
    },
    "remaining_count": {
      "description": "Remaining records when mechanically knowable.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ActivationBand": {
      "description": "Current activation band assigned to a problem region.\n\nA band changes visibility and foregrounding only. It does not duplicate the region or change its identity, applicability, lifecycle, or semantic strength. It is categorical and never a numeric attention or relevance score.",
      "oneOf": [
        {
          "description": "Immediate operational focus.",
          "type": "string",
          "enum": [
            "primary"
          ]
        },
        {
          "description": "Live adjacent structure that materially informs primary focus.",
          "type": "string",
          "enum": [
            "secondary"
          ]
        },
        {
          "description": "Lower-priority connected structure available for continuation.",
          "type": "string",
          "enum": [
            "tertiary"
          ]
        },
        {
          "description": "Retained continuity outside the current foreground.",
          "type": "string",
          "enum": [
            "background"
          ]
        }
      ]
    },
    "ActivationProvenance": {
      "description": "Source of positive activation for one visible record or edge.\n\nProvenance explains navigation only. It is not a relevance, confidence, or truth score and cannot close an open tension.",
      "oneOf": [
        {
          "description": "Exposed by one active problem region.",
          "type": "object",
          "required": [
            "kind",
            "region_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "problem_region"
              ]
            },
            "region_id": {
              "description": "Thread-local problem-region identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one specific problem-space referent expression.\n\nThis records the textual source that caused exposure. It does not assert that the referent is canonically bound to the activated address.",
          "type": "object",
          "required": [
            "kind",
            "referent_id",
            "region_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "problem_referent"
              ]
            },
            "referent_id": {
              "description": "Thread-local problem-referent identity.",
              "type": "string"
            },
            "region_id": {
              "description": "Containing problem-region identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one problem-space relation.",
          "type": "object",
          "required": [
            "kind",
            "relation_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "problem_relation"
              ]
            },
            "relation_id": {
              "description": "Thread-local problem-relation identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one active problem-space constraint.",
          "type": "object",
          "required": [
            "constraint_id",
            "kind"
          ],
          "properties": {
            "constraint_id": {
              "description": "Thread-local constraint identity.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "constraint"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one explicit open tension.",
          "type": "object",
          "required": [
            "kind",
            "tension_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "open_tension"
              ]
            },
            "tension_id": {
              "description": "Thread-local tension identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one preserved candidate of an open tension.\n\nCandidate order is the declared vector order in the problem-space state. Exposure does not select this candidate or resolve the tension.",
          "type": "object",
          "required": [
            "candidate_index",
            "kind",
            "tension_id"
          ],
          "properties": {
            "candidate_index": {
              "description": "Zero-based candidate index within the preserved candidate vector.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "kind": {
              "type": "string",
              "enum": [
                "open_tension_candidate"
              ]
            },
            "tension_id": {
              "description": "Thread-local open-tension identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by one region's current attention band.",
          "type": "object",
          "required": [
            "band",
            "kind",
            "region_id"
          ],
          "properties": {
            "band": {
              "description": "Current band in the shared attention lens.",
              "allOf": [
                {
                  "$ref": "#/definitions/ActivationBand"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "attention_band"
              ]
            },
            "region_id": {
              "description": "Region carrying the activation band.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by the newest utterance.",
          "type": "object",
          "required": [
            "kind",
            "utterance_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "newest_utterance"
              ]
            },
            "utterance_id": {
              "description": "Current utterance identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by a deterministic configuration default.",
          "type": "object",
          "required": [
            "configuration_key",
            "kind"
          ],
          "properties": {
            "configuration_key": {
              "description": "Stable configuration key.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "configured_default"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Exposed by a typed bounded expansion request.",
          "type": "object",
          "required": [
            "kind",
            "request_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "expansion_request"
              ]
            },
            "request_id": {
              "description": "Expansion request identity.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ContinuationAccess": {
      "description": "Mechanism through which a continuation page is interpreted.\n\nProjection-structure continuation follows frozen represented topology directly. Retrieval-surface continuation resumes one concrete projected surface. Neither variant executes continuation by itself.",
      "oneOf": [
        {
          "description": "Continue deterministic structure represented directly by the projection.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "projection_structure"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Continue one concrete projected retrieval surface.",
          "type": "object",
          "required": [
            "kind",
            "surface_id",
            "surface_kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "retrieval_surface"
              ]
            },
            "surface_id": {
              "description": "Concrete snapshot-local surface identity.",
              "type": "string"
            },
            "surface_kind": {
              "description": "Stable surface family declared by the projection.",
              "allOf": [
                {
                  "$ref": "#/definitions/RetrievalSurfaceKind"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ContinuationFilter": {
      "description": "Typed filter applied to a continuation handle.",
      "oneOf": [
        {
          "description": "Restrict to one projected structural transition.",
          "type": "object",
          "required": [
            "kind",
            "transition_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "transition"
              ]
            },
            "transition_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Restrict source objects to a canonical path prefix.",
          "type": "object",
          "required": [
            "canonical_path_prefix",
            "kind"
          ],
          "properties": {
            "canonical_path_prefix": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "source_path_prefix"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Restrict to one projected semantic-object class.",
          "type": "object",
          "required": [
            "kind",
            "object_class"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object_class"
              ]
            },
            "object_class": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Restrict by one projected identifier and optional represented value.",
          "type": "object",
          "required": [
            "identifier_name",
            "kind"
          ],
          "properties": {
            "identifier_name": {
              "description": "Projected identifier descriptor name.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "identifier"
              ]
            },
            "represented_value": {
              "description": "Optional exact represented projected value.",
              "anyOf": [
                {
                  "$ref": "#/definitions/IdentifierValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Restrict by a temporal range.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "end": {
              "anyOf": [
                {
                  "$ref": "#/definitions/TemporalValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "temporal_range"
              ]
            },
            "start": {
              "anyOf": [
                {
                  "$ref": "#/definitions/TemporalValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ContinuationOrdering": {
      "description": "Stable ordering under which a continuation cursor is interpreted.",
      "oneOf": [
        {
          "description": "Stable order of the corresponding frozen projection vector.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "projection_vector_order"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Stable order declared by one deterministic surface.",
          "type": "object",
          "required": [
            "kind",
            "ordering_key"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "surface_declared"
              ]
            },
            "ordering_key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ContinuationOrigin": {
      "description": "Original probe or structural neighbourhood described by a continuation handle.",
      "oneOf": [
        {
          "description": "Continuation of one deterministic textual surface probe.",
          "type": "object",
          "required": [
            "kind",
            "match_mode",
            "query_text"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "text_probe"
              ]
            },
            "match_mode": {
              "$ref": "#/definitions/SurfaceMatchMode"
            },
            "query_text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Continuation of one structural neighbourhood.",
          "type": "object",
          "required": [
            "kind",
            "subject"
          ],
          "properties": {
            "direction": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Direction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "structural_neighbourhood"
              ]
            },
            "subject": {
              "$ref": "#/definitions/SemanticAddress"
            },
            "transition_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Continuation of one temporal surface probe.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "end": {
              "anyOf": [
                {
                  "$ref": "#/definitions/TemporalValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "temporal_probe"
              ]
            },
            "start": {
              "anyOf": [
                {
                  "$ref": "#/definitions/TemporalValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Direction": {
      "description": "Explicit direction for a represented structural connection.\n\nDirection authorizes no traversal by itself; it is valid only when the projection represents the requested incidence.",
      "oneOf": [
        {
          "description": "Move from source incidence toward its represented target.",
          "type": "string",
          "enum": [
            "outgoing"
          ]
        },
        {
          "description": "Move from a target toward represented incoming incidence.",
          "type": "string",
          "enum": [
            "incoming"
          ]
        }
      ]
    },
    "IdentifierAddress": {
      "description": "Address of an identifier descriptor or assignment.\n\nIt represents a named projected surface and optional represented value. It cannot replace canonical object or unit identity.",
      "type": "object",
      "required": [
        "identifier_name"
      ],
      "properties": {
        "identifier_name": {
          "description": "Identifier name represented by the projection.",
          "type": "string"
        },
        "represented_value": {
          "description": "Optional exact represented value used to address one assignment.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "IdentifierValue": {
      "description": "Value carried by one identifier assignment.\n\nThis is a closed structural union for exchange. It cannot be interpreted as evidence or a relation without its descriptor and provenance.",
      "oneOf": [
        {
          "description": "Authored field is present with a null value.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One string value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "string"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One signed integer value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "integer"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One boolean value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "boolean"
              ]
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "One canonical address value.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semantic_address"
              ]
            },
            "value": {
              "$ref": "#/definitions/SemanticAddress"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection of strings.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "strings"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection of signed integers.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "integers"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection of booleans.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "booleans"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection whose elements have more than one mechanical value shape.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "values"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/IdentifierValue"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Collection of canonical addresses.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semantic_addresses"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SemanticAddress"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RetrievalSurfaceAddress": {
      "description": "Address of a retrieval-surface descriptor.\n\nIt names a projected capability only. It does not execute the surface or imply that the surface is available for a particular address.",
      "type": "object",
      "required": [
        "surface_id"
      ],
      "properties": {
        "surface_id": {
          "description": "Snapshot-local retrieval-surface identifier.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RetrievalSurfaceKind": {
      "description": "Retrieval-surface families admitted by the contracts.\n\nA family describes a capability class only; the projection determines whether a concrete surface exists and what it may inspect.",
      "oneOf": [
        {
          "description": "Literal or exact matching.",
          "type": "string",
          "enum": [
            "exact"
          ]
        },
        {
          "description": "Lexical matching.",
          "type": "string",
          "enum": [
            "lexical"
          ]
        },
        {
          "description": "Vector-neighbour lookup.",
          "type": "string",
          "enum": [
            "vector"
          ]
        },
        {
          "description": "Graph or incidence navigation.",
          "type": "string",
          "enum": [
            "graph"
          ]
        },
        {
          "description": "Temporal lookup or ordering.",
          "type": "string",
          "enum": [
            "temporal"
          ]
        }
      ]
    },
    "SemanticAddress": {
      "description": "Canonical or projected address used by plans and provenance records.\n\nIt can point only to represented address categories. It does not prove that the target exists in a given snapshot; structural conformance owns that later check.",
      "oneOf": [
        {
          "description": "Canonical semantic object.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Canonical semantic unit.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unit"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Authored semantic region.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "region"
              ]
            },
            "value": {
              "$ref": "#/definitions/SemanticRegionAddress"
            }
          },
          "additionalProperties": false
