{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectionAccessArtifacts",
  "type": "object",
  "required": [
    "artifact_identity",
    "exact",
    "graph",
    "lexical",
    "manifest",
    "temporal",
    "vector"
  ],
  "properties": {
    "artifact_identity": {
      "type": "string"
    },
    "exact": {
      "$ref": "#/definitions/ExactIndex"
    },
    "graph": {
      "$ref": "#/definitions/GraphIndex"
    },
    "lexical": {
      "$ref": "#/definitions/LexicalIndex"
    },
    "manifest": {
      "$ref": "#/definitions/ProjectionAccessManifest"
    },
    "temporal": {
      "$ref": "#/definitions/TemporalIndex"
    },
    "vector": {
      "$ref": "#/definitions/VectorIndex"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AccessFailure": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Direction": {
      "description": "Explicit direction for a represented structural connection.\n\nDirection authorizes no traversal by itself; it is valid only when the projection represents the requested incidence.",
      "oneOf": [
        {
          "description": "Move from source incidence toward its represented target.",
          "type": "string",
          "enum": [
            "outgoing"
          ]
        },
        {
          "description": "Move from a target toward represented incoming incidence.",
          "type": "string",
          "enum": [
            "incoming"
          ]
        }
      ]
    },
    "ExactIndex": {
      "type": "object",
      "required": [
        "entries",
        "index_identity"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExactIndexEntry"
          }
        },
        "index_identity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExactIndexEntry": {
      "type": "object",
      "required": [
        "literal",
        "representation",
        "unit_id"
      ],
      "properties": {
        "literal": {
          "type": "string"
        },
        "representation": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "FtsTokenizerConfiguration": {
      "description": "A deterministic, technical description of the lexical index tokenizer.",
      "type": "object",
      "required": [
        "case_folding",
        "implementation",
        "punctuation",
        "stop_words",
        "tokenization"
      ],
      "properties": {
        "case_folding": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "punctuation": {
          "type": "string"
        },
        "stop_words": {
          "type": "string"
        },
        "tokenization": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GraphEdge": {
      "type": "object",
      "required": [
        "direction",
        "source",
        "target",
        "transition_id"
      ],
      "properties": {
        "direction": {
          "$ref": "#/definitions/Direction"
        },
        "source": {
          "$ref": "#/definitions/SemanticAddress"
        },
        "target": {
          "$ref": "#/definitions/SemanticAddress"
        },
        "transition_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GraphIndex": {
      "type": "object",
      "required": [
        "edges",
        "index_identity"
      ],
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphEdge"
          }
        },
        "index_identity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "IdentifierAddress": {
      "description": "Address of an identifier descriptor or assignment.\n\nIt represents a named projected surface and optional represented value. It cannot replace canonical object or unit identity.",
      "type": "object",
      "required": [
        "identifier_name"
      ],
      "properties": {
        "identifier_name": {
          "description": "Identifier name represented by the projection.",
          "type": "string"
        },
        "represented_value": {
          "description": "Optional exact represented value used to address one assignment.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LexicalIndex": {
      "type": "object",
      "required": [
        "index_identity",
        "postings",
        "tokenizer"
      ],
      "properties": {
        "index_identity": {
          "type": "string"
        },
        "postings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LexicalPosting"
          }
        },
        "tokenizer": {
          "$ref": "#/definitions/FtsTokenizerConfiguration"
        }
      },
      "additionalProperties": false
    },
    "LexicalPosting": {
      "type": "object",
      "required": [
        "token",
        "unit_id"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ProjectionAccessManifest": {
      "type": "object",
      "required": [
        "access_schema_version",
        "corpus_snapshot_identity",
        "exact_index_identity",
        "graph_index_identity",
        "lexical_index_identity",
        "projection_logical_hash",
        "projection_snapshot_id",
        "temporal_index_identity",
        "vector_index_identity",
        "vector_provider"
      ],
      "properties": {
        "access_schema_version": {
          "type": "string"
        },
        "corpus_snapshot_identity": {
          "type": "string"
        },
        "exact_index_identity": {
          "type": "string"
        },
        "graph_index_identity": {
          "type": "string"
        },
        "lexical_index_identity": {
          "type": "string"
        },
        "projection_logical_hash": {
          "type": "string"
        },
        "projection_snapshot_id": {
          "type": "string"
        },
        "temporal_index_identity": {
          "type": "string"
        },
        "vector_index_identity": {
          "type": "string"
        },
        "vector_provider": {
          "$ref": "#/definitions/VectorProviderState"
        }
      },
      "additionalProperties": false
    },
    "RetrievalSurfaceAddress": {
      "description": "Address of a retrieval-surface descriptor.\n\nIt names a projected capability only. It does not execute the surface or imply that the surface is available for a particular address.",
      "type": "object",
      "required": [
        "surface_id"
      ],
      "properties": {
        "surface_id": {
          "description": "Snapshot-local retrieval-surface identifier.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SemanticAddress": {
      "description": "Canonical or projected address used by plans and provenance records.\n\nIt can point only to represented address categories. It does not prove that the target exists in a given snapshot; structural conformance owns that later check.",
      "oneOf": [
        {
          "description": "Canonical semantic object.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "object"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Canonical semantic unit.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unit"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Authored semantic region.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "region"
              ]
            },
            "value": {
              "$ref": "#/definitions/SemanticRegionAddress"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Identifier assignment or descriptor.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "identifier"
              ]
            },
            "value": {
              "$ref": "#/definitions/IdentifierAddress"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Authored occurrence.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "occurrence"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Temporal anchor.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "temporal_anchor"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Retrieval surface.",
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "retrieval_surface"
              ]
            },
            "value": {
              "$ref": "#/definitions/RetrievalSurfaceAddress"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SemanticRegionAddress": {
      "description": "Address of an authored structural region inside one semantic object.\n\nThe address preserves both the canonical parent object and a non-empty authored structural address. It has no authority to select a unit, infer a heading target, or treat the region as a separate epistemic object class.",
      "type": "object",
      "required": [
        "authored_structural_address",
        "object_id"
      ],
      "properties": {
        "authored_structural_address": {
          "description": "Non-empty authored heading, block, or structural address.",
          "type": "string"
        },
        "object_id": {
          "description": "Canonical parent semantic object.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TemporalIndex": {
      "type": "object",
      "required": [
        "entries",
        "index_identity"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TemporalIndexEntry"
          }
        },
        "index_identity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TemporalIndexEntry": {
      "type": "object",
      "required": [
        "anchor_id",
        "precision",
        "subject",
        "value"
      ],
      "properties": {
        "anchor_id": {
          "type": "string"
        },
        "precision": {
          "$ref": "#/definitions/TemporalPrecision"
        },
        "subject": {
          "$ref": "#/definitions/SemanticAddress"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TemporalPrecision": {
      "type": "string",
      "enum": [
        "FullDate",
        "DateTime",
        "ExactYear",
        "MonthDay",
        "ApproximateYear"
      ]
    },
    "VectorIndex": {
      "type": "object",
      "required": [
        "index_identity",
        "provider",
        "segments"
      ],
      "properties": {
        "index_identity": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/VectorProviderState"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VectorSegmentRecord"
          }
        }
      },
      "additionalProperties": false
    },
    "VectorProviderContract": {
      "description": "Technical vector-provider contract.  None of these fields are projection facts and changing them cannot mutate the projection snapshot.",
      "type": "object",
      "required": [
        "dimension",
        "dtype",
        "normalization",
        "provider",
        "requested_model",
        "similarity",
        "truncation"
      ],
      "properties": {
        "dimension": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "dtype": {
          "type": "string"
        },
        "normalization": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "requested_model": {
          "type": "string"
        },
        "similarity": {
          "type": "string"
        },
        "truncation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "VectorProviderIdentity": {
      "description": "Immutable provider identity resolved outside the projection.",
      "type": "object",
      "required": [
        "contract",
        "endpoint",
        "model_digest",
        "resolved_model"
      ],
      "properties": {
        "contract": {
          "$ref": "#/definitions/VectorProviderContract"
        },
        "endpoint": {
          "type": "string"
        },
        "max_input_chars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "model_digest": {
          "type": "string"
        },
        "resolved_model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "VectorProviderState": {
      "description": "Provider state is technical state, not corpus or projection state.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "identity",
            "state"
          ],
          "properties": {
            "identity": {
              "$ref": "#/definitions/VectorProviderIdentity"
            },
            "state": {
              "type": "string",
              "enum": [
                "ready"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "contract",
            "failure",
            "state"
          ],
          "properties": {
            "contract": {
              "$ref": "#/definitions/VectorProviderContract"
            },
            "failure": {
              "$ref": "#/definitions/AccessFailure"
            },
            "state": {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "VectorSegmentRecord": {
      "type": "object",
      "required": [
        "embedding",
        "parent_unit_id",
        "segment_id",
        "segment_ordinal",
        "total_segments"
      ],
      "properties": {
        "embedding": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "parent_unit_id": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "segment_ordinal": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "total_segments": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
